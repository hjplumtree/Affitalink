# Required in production. Generate once with: openssl rand -hex 32
# Back it up. Changing it makes saved network credentials unreadable.
# Local development may omit it and use .affitalink-data/app-secret.
AFFITALINK_SECRET=

# Supabase backend
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
